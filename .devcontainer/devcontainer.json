{
  "name": "omed",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers-extra/features/mise:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [3000, 8001, 9001, 8080, 5432, 4983],
  "portsAttributes": {
    "3000": { "label": "@omed/dash" },
    "8001": { "label": "@omed/api" },
    "9001": { "label": "rustfs console" },
    "8080": { "label": "kafka ui" },
    "5432": { "label": "postgres" },
    "4983": { "label": "drizzle studio" }
  },
  "containerEnv": {
    "MISE_DATA_DIR": "/mnt/mise-data"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/mnt/mise-data/shims"
  },
  "onCreateCommand": "sudo mkdir -p /mnt/mise-data && sudo chown -R \"$(id -u):$(id -g)\" /mnt/mise-data /commandhistory",
  // Runs in Codespaces prebuilds, so dependencies are cached
  "updateContentCommand": "mise install && bun install",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Runs on every start: the named volume can come back root-owned
  "postStartCommand": "sudo chown \"$(id -u):$(id -g)\" /commandhistory && sudo chown -R \"$(id -u):$(id -g)\" /mnt/mise-data && touch /commandhistory/.bash_history",
  "customizations": {
    "vscode": {
      "extensions": [
        "hverlin.mise-vscode",
        "golang.go",
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "cloudflare.vscode-wrangler",
        "ms-azuretools.vscode-docker",
        "editorconfig.editorconfig",
        "CucumberOpen.cucumber-official",
        "google.google-antigravity",
        "vitest.explorer",
        "github.vscode-github-actions",
        "ms-ossdata.vscode-pgsql"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "cucumber.features": ["apps/e2e/features/**/*.feature"],
        "cucumber.glue": ["apps/e2e/steps/**/*.ts"],
        "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
        "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
        "[json]": { "editor.defaultFormatter": "biomejs.biome" },
        "[go]": { "editor.defaultFormatter": "golang.go" }
      }
    }
  }
}
