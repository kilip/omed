{
  "name": "@omed/auth",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/dev.ts",
    "auth:schema": "bun x auth@latest generate --config ../../packages/better-auth/src/auth.ts --output ../../packages/better-auth/src/drizzle/schema/better-auth.ts --yes",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@omed/better-auth": "*",
    "@omed/tsconfig": "*",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^1.0.0-beta.22",
    "typescript": "^6"
  },
  "dependencies": {
    "@better-auth/telemetry": "^1.7.6",
    "@elysia/cors": "^1.4.2",
    "@elysia/openapi": "^1.4.16",
    "better-auth": "^1.7.6",
    "elysia": "^1.4.30"
  }
}
