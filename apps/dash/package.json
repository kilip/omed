{
  "name": "@omed/dash",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev --port 3001 --host",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test:e2e": "NODE_OPTIONS='--import tsx' cucumber-js --config e2e/cucumber.json",
    "test:e2e:report": "NODE_OPTIONS='--import tsx' cucumber-js --config e2e/cucumber.json --format html:e2e-report.html"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@omed/api": "*",
    "@omed/better-auth": "*",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@t3-oss/env-core": "^0.13.11",
    "antd": "^6.6.5",
    "better-auth": "^1.7.6",
    "isbot": "^5.1.36",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
