{
  "name": "omed",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "e2e": "bun run --cwd e2e test",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check": "biome check",
    "check:write": "biome check --write",
    "format": "biome format --write",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "auth:schema": "turbo run auth:schema",
    "db:push": "turbo run db:push",
    "oa:gen": "turbo run openapi:gen",
    "oa:finance": "openapi-typescript ./apps/finance/docs/swag/swagger.json -o ./packages/openapi/src/specs/finance.ts",
    "openapi": "bun oa:gen && bun oa:finance"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "turbo": "^2.5.0",
    "typescript": "^6"
  }
}
