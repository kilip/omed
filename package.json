{
  "name": "omed",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev --ui=tui",
    "lint": "turbo run lint",
    "format": "biome format --write",
    "check-types": "turbo run check-types",
    "test": "turbo run test --ui=tui",
    "auth:schema": "turbo run auth:schema",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.4"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  }
}
