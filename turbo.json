{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": ["OMED_*", "E2E_*", "HEADED"],
  "tasks": {
    "e2e": {
      "cache": false
    },
    "typecheck": {
      "cache": false,
      "persistent": true
