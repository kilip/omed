{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": ["OMED_*"],
  "tasks": {
    "e2e": {
      "cache": false
    },
    "typecheck": {
      "cache": false,
      "persistent": true
    },
    "build": {},
    "test": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@omed/better-auth#auth:schema": {
      "cache": false
    },
    "@omed/better-auth#db:push": {
      "cache": false,
      "dependsOn": ["@omed/better-auth#auth:schema"]
    }
  }
}
